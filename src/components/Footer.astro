---
// Site footer. The Endless Customers footer carries the parent line, per the September 18 structure.
import type { SiteId } from '../lib/site';
import { href } from '../lib/site';
import ImpactLogo from './ImpactLogo.astro';
import ECLogo from './ECLogo.astro';

interface Props { site: SiteId }
const { site } = Astro.props;
const isEC = site === 'ec';
const year = new Date().getFullYear();

const impactCols = [
  { h: 'Services', links: [['Deep Diagnostic & Roadmap', '/deep-diagnostic'], ['Endless Customers Coaching', '/coaching'], ['HubSpot Services', '/hubspot'], ['Website Services', '/websites'], ['Paid Media Services', '/paid-media'], ['Workshops', '/workshops']] },
  { h: 'Results', links: [['Success Stories', '/results/success-stories'], ['Website Portfolio', '/results/website-portfolio'], ['Awards & Recognition', '/results/awards'], ['Reviews', '/results/reviews']] },
  { h: 'Company', links: [['About', '/about'], ['Why IMPACT?', '/why-impact'], ['Meet Our Team', '/team'], ['Request a Speaker', '/speaking'], ['Join Our Team', '/careers'], ['Pricing', '/pricing']] },
  { h: 'Learn', links: [['Learning Center', '/learn'], ['Instant Diagnostic', '/instant-diagnostic'], ['AI Visibility Study', '/ai-visibility-study'], ['Webinars & Workshops', '/events']] },
];
const ecCols = [
  { h: 'The System', links: [['The Book', '/book'], ['What is Endless Customers?', '/what-is-endless-customers'], ['How to Implement', '/how-to-implement'], ['Pricing', '/pricing']] },
  { h: 'Coaching', links: [['Get Coaching & Training', '/coaching'], ['Our Coaches', '/coaches'], ['Become a Coach', '/become-a-coach'], ['Success Stories', '/success-stories']] },
  { h: 'Learn', links: [['Learning Center', '/learn'], ['Endless Customers Academy', '/academy'], ['Free Instant AI Diagnostic', '/instant-diagnostic'], ['The Podcast', '/podcast'], ['Webinars', '/webinars']] },
  { h: 'Events', links: [['The Conference', '/conference'], ['Book a Free Call', '/book-a-call']] },
];
const cols = isEC ? ecCols : impactCols;
---

<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div class="brand">
        <a class:list={['logo', { ec: isEC }]} href={href(site, '/')} aria-label="Home">{isEC ? <ECLogo /> : <ImpactLogo />}</a>
        {isEC
          ? <p>Endless Customers is a brand of <a href={href('impact', '/')}>IMPACT</a>, the company behind the system and the coaching.</p>
          : <p>IMPACT helps companies become the most known, trusted, and recommended company in their market in the age of AI, and builds the systems and internal capabilities inside your business that keep it that way.</p>}
        {!isEC && <p class="addr">125 Commerce Ct STE 9, Cheshire, CT 06410 · (203) 265-4377 · Founded 2009 · Serving the US and Canada</p>}
      </div>
      {cols.map((c) => (
        <div>
          <h4>{c.h}</h4>
          <ul>{c.links.map(([label, path, s]) => <li><a href={href((s as SiteId) ?? site, path)}>{label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="legal">
      <span>© {year} IMPACT</span>
      <a href={href(site, '/privacy')}>Privacy</a>
      <a href={href(site, '/terms')}>Terms</a>
      {isEC ? <a class="right" href={href('impact', '/')}>impactplus.com →</a> : <a class="right" href={href('ec', '/')}>endlesscustomers.com →</a>}
    </div>
  </div>
</footer>
