---
// The global header for either site. Desktop sheets and the mobile accordion both render
// from the same nav data, so a label change happens once.
import type { NavItem, NavLink, SiteId } from '../lib/site';
import { href } from '../lib/site';
import ImpactLogo from './ImpactLogo.astro';
import ECLogo from './ECLogo.astro';

interface Props {
  site: SiteId;
  nav: NavItem[];
  cta: NavLink;
  /** Ghost button to the left of the main call to action. */
  secondary?: NavLink;
  /** Line under the mobile menu's button. */
  mobileNote?: { text: string; link?: NavLink };
  currentPath?: string;
}
const { site, nav, cta, secondary, mobileNote, currentPath = '' } = Astro.props;
const isEC = site === 'ec';
const mobileId = `mobile-${site}`;

const linkHref = (l: NavLink) => href(l.site ?? site, l.path);
const crosses = (l: NavLink) => l.site && l.site !== site;
---

<header class="header">
  <div class="wrap">
    <a class:list={['logo', { ec: isEC }]} href={href(site, '/')} aria-label={isEC ? 'Endless Customers home' : 'IMPACT home'}>
      {isEC ? <ECLogo /> : <ImpactLogo />}
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) =>
        item.kind === 'link' ? (
          <div class="nav-item"><a class="nav-btn" href={href(site, item.path)} aria-current={currentPath === item.path ? 'page' : undefined}>{item.label}</a></div>
        ) : (
          <div class="nav-item">
            <button class="nav-btn" data-menu={item.id} aria-expanded="false" aria-controls={`sheet-${item.id}`}>
              {item.label} <svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3"/></svg>
            </button>
          </div>
        )
      )}
    </nav>

    <div class="tools">
      <button class="icon-btn search" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span class="tip" aria-hidden="true">Search</span></button>
      {isEC && (
        <a class="icon-btn account" href="https://app.impactplus.com/users/sign_in" target="_blank" rel="noopener" aria-label="Endless Customers Academy login (opens in new tab)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20.5c1.2-3.6 4.2-5.5 8-5.5s6.8 1.9 8 5.5"/></svg><span class="tip" aria-hidden="true">Academy Login</span>
        </a>
      )}
      <button class="icon-btn theme" aria-label="Switch to Dark Mode" data-theme-toggle>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <span class="tip tip-light" aria-hidden="true">Switch to Dark Mode</span><span class="tip tip-dark" aria-hidden="true">Switch to Light Mode</span>
      </button>
      {secondary && <a class="cta ghost" href={href(site, secondary.path)}>{secondary.label}</a>}
      <a class:list={['cta', { grad: isEC }]} href={href(site, cta.path)}>{cta.label} <span class="arr" aria-hidden="true">→</span></a>
      <button class="icon-btn burger" aria-label="Menu" aria-expanded="false" aria-controls={mobileId} data-burger={mobileId}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="open" d="M4 7h16M4 12h16M4 17h16"/><path class="close" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="scrim" data-scrim></div>

{nav.map((item) => {
  if (item.kind === 'panel') return (
    <section class="sheet" id={`sheet-${item.id}`} data-sheet={item.id} aria-label={item.label}>
      <div class="wrap">
        <div class="help">
          {item.columns.map((col) => (
            <div class:list={['col', col.className]}>
              <h3>{col.heading}</h3>
              <ul>{col.links.map((l) => <li data-when={l.whenProof ? 'proof' : undefined}><a href={linkHref(l)}>{l.label}{l.badge && <span class="badge">{l.badge}</span>}</a></li>)}</ul>
              {col.more && <a class="more" href={linkHref(col.more)}>{col.more.label} <span class="arrow">→</span></a>}
            </div>
          ))}
        </div>
        <div class="help-foot">
          {item.foot.map((row, i) => (
            <div class="row">
              {i === 0
                ? <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
                : <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M8 20h8M5 8h14"/><path d="M6 8l-3 6c0 1.7 1.3 3 3 3s3-1.3 3-3L6 8zM18 8l-3 6c0 1.7 1.3 3 3 3s3-1.3 3-3l-3-6z"/></svg>}
              <span>{row.text}</span>
              <a href={linkHref(row.link)}>{row.link.label} <span class="arrow">→</span></a>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
  if (item.kind === 'menu') return (
    <section class="sheet small" id={`sheet-${item.id}`} data-sheet={item.id} aria-label={item.label}>
      <div class="wrap">
        {item.groups.map((g) => (
          <>
            {g.heading && <div class="group">{g.heading}</div>}
            {g.rule && <div class="rule"></div>}
            <div class="list">
              {g.links.map((l) => (
                <a class:list={{ ext: crosses(l) }} href={linkHref(l)}>{l.label}{l.sub && <div class="sub">{l.sub}</div>}</a>
              ))}
            </div>
          </>
        ))}
      </div>
    </section>
  );
  return null;
})}

<div class="mobile" id={mobileId} aria-label="Menu">
  <div class="wrap">
    {nav.map((item) =>
      item.kind === 'link' ? (
        <div class="acc"><a href={href(site, item.path)}>{item.label}</a></div>
      ) : (
        <div class="acc">
          <button aria-expanded="false">{item.label} <svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3"/></svg></button>
          <div class="acc-body">
            {item.kind === 'panel'
              ? item.columns.map((col, i) => (
                  <>
                    <h4>{col.heading}</h4>
                    <ul class:list={{ big: i === 0 }}>{col.links.map((l) => <li data-when={l.whenProof ? 'proof' : undefined}><a href={linkHref(l)}>{l.label}{l.badge && <span class="badge">{l.badge}</span>}</a></li>)}</ul>
                    {col.more && <a class="more" href={linkHref(col.more)}>{col.more.label} →</a>}
                  </>
                ))
              : item.groups.map((g) => (
                  <>
                    {g.heading && <h4>{g.heading}</h4>}
                    <ul>{g.links.map((l) => <li><a href={linkHref(l)}>{l.label}{crosses(l) ? ' ↗' : ''}</a></li>)}</ul>
                  </>
                ))}
          </div>
        </div>
      )
    )}
    <div class="foot">
      <a class:list={['cta', { grad: isEC }]} href={href(site, cta.path)}>{cta.label}</a>
      {isEC && <p><a href="https://app.impactplus.com/users/sign_in" target="_blank" rel="noopener">Academy Login ↗</a></p>}
      {!isEC && <p>Every service we offer is backed by our <a href={href('impact', '/guarantee')}>100% money-back guarantee →</a></p>}
      {mobileNote && <p>{mobileNote.text} {mobileNote.link && <a href={linkHref(mobileNote.link)}>{mobileNote.link.label} →</a>}</p>}
    </div>
  </div>
</div>

<script>
  // Hover-intent dropdowns, click toggle, Escape, scrim, focus-out; mobile burger and accordion.
  const body = document.body;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.nav-btn[data-menu]')];
  const sheets = new Map([...document.querySelectorAll<HTMLElement>('[data-sheet]')].map((s) => [s.dataset.sheet!, s]));
  let open: string | null = null, hoverTimer = 0, leaveTimer = 0;

  function positionSmall(sheet: HTMLElement, btn: HTMLElement) {
    if (!sheet.classList.contains('small')) return;
    const r = btn.getBoundingClientRect();
    sheet.style.left = Math.max(12, r.left - 8) + 'px';
  }
  function show(name: string) {
    if (open === name) return;
    hide();
    const btn = buttons.find((b) => b.dataset.menu === name);
    const sheet = sheets.get(name);
    if (!btn || !sheet) return;
    positionSmall(sheet, btn);
    btn.setAttribute('aria-expanded', 'true');
    sheet.setAttribute('data-show', '');
    body.setAttribute('data-open', name);
    open = name;
  }
  function hide() {
    if (!open) return;
    buttons.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    sheets.forEach((s) => s.removeAttribute('data-show'));
    body.removeAttribute('data-open');
    open = null;
  }
  const cancelTimers = () => { clearTimeout(hoverTimer); clearTimeout(leaveTimer); };

  buttons.forEach((btn) => {
    const name = btn.dataset.menu!;
    btn.addEventListener('click', () => (open === name ? hide() : show(name)));
    btn.addEventListener('mouseenter', () => { cancelTimers(); hoverTimer = window.setTimeout(() => show(name), open ? 40 : 120); });
    btn.addEventListener('mouseleave', () => { cancelTimers(); leaveTimer = window.setTimeout(hide, 220); });
  });
  sheets.forEach((sheet) => {
    sheet.addEventListener('mouseenter', cancelTimers);
    sheet.addEventListener('mouseleave', () => { cancelTimers(); leaveTimer = window.setTimeout(hide, 220); });
  });
  document.querySelector('[data-scrim]')?.addEventListener('click', hide);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { hide(); closeMobile(); } });
  document.addEventListener('focusin', (e) => {
    if (!open) return;
    const t = e.target as HTMLElement;
    if (!t.closest('.header') && !t.closest('[data-sheet]')) hide();
  });

  const burgers = [...document.querySelectorAll<HTMLButtonElement>('[data-burger]')];
  function closeMobile() {
    document.querySelectorAll('.mobile').forEach((m) => m.removeAttribute('data-show'));
    burgers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    document.documentElement.style.overflow = '';
  }
  burgers.forEach((burger) => burger.addEventListener('click', () => {
    const mobile = document.getElementById(burger.dataset.burger!)!;
    if (mobile.hasAttribute('data-show')) closeMobile();
    else { closeMobile(); mobile.setAttribute('data-show', ''); burger.setAttribute('aria-expanded', 'true'); document.documentElement.style.overflow = 'hidden'; }
  }));
  document.querySelectorAll<HTMLButtonElement>('.acc > button').forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.acc > button').forEach((x) => x.setAttribute('aria-expanded', 'false'));
    b.setAttribute('aria-expanded', on ? 'false' : 'true');
  }));

  // Theme: follows the system until the visitor picks; the pick is remembered in this browser.
  const root = document.documentElement;
  // Tall header at the top of the page; compact once scrolled. Drives the --header-h family in global.css.
  const onScroll = () => root.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll(); addEventListener('scroll', onScroll, { passive: true });

  const themeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  function applyTheme(pick: string | null) {
    if (pick) root.setAttribute('data-theme', pick); else root.removeAttribute('data-theme');
    const dark = pick ? pick === 'dark' : mq.matches;
    dark ? root.setAttribute('data-dark', '') : root.removeAttribute('data-dark');
    themeBtns.forEach((b) => b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'));
  }
  let pick: string | null = null;
  try { pick = localStorage.getItem('impact-theme'); } catch {}
  applyTheme(pick);
  mq.addEventListener('change', () => applyTheme(pick));
  themeBtns.forEach((b) => b.addEventListener('click', () => {
    pick = root.hasAttribute('data-dark') ? 'light' : 'dark';
    try { localStorage.setItem('impact-theme', pick); } catch {}
    applyTheme(pick);
  }));
</script>
