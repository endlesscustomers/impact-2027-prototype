---
// Microsite local nav: sits under the ribbon on every page of a service section. Name on the left,
// section pages in the middle, the section's own call to action on the right. Sticky under the header.
import type { Microsite } from '../data/microsites';
import { href } from '../lib/site';

interface Props { ms: Microsite; path: string }
const { ms, path } = Astro.props;
const clean = '/' + path.replace(/^\/+|\/+$/g, '');
---

<nav class="localnav" aria-label={ms.name}>
  <div class="wrap">
    <a class="name" href={href('impact', ms.base)}>{ms.name}</a>
    <ul>
      {ms.links.map((l) => {
        const here = !l.site && !l.hash && clean === l.path;
        return <li><a href={href(l.site ?? 'impact', l.path) + (l.hash ? '#' + l.hash : '')} aria-current={here ? 'page' : undefined} class:list={{ ext: !!l.site }}>{l.label}</a></li>;
      })}
    </ul>
    <a class="cta" href={href('impact', ms.cta.path)}>{ms.cta.label}</a>
  </div>
</nav>

<style>
  .localnav { position: sticky; top: var(--header-h); z-index: 30; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid var(--line); }
  .localnav .wrap { display: flex; align-items: center; gap: 28px; height: 48px; }
  .name { flex: none; font-size: 17px; font-weight: 600; letter-spacing: -.015em; }
  ul { list-style: none; margin: 0 0 0 auto; padding: 0; display: flex; gap: 22px; overflow-x: auto; scrollbar-width: none; }
  ul::-webkit-scrollbar { display: none; }
  li a { position: relative; display: block; padding: 14px 0; font-size: 13px; color: var(--ink-2); white-space: nowrap; }
  li a:hover { color: var(--ink); }
  li a[aria-current="page"] { color: var(--ink); }
  li a[aria-current="page"]::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--ink); }
  li a.ext::after { content: " ↗"; color: var(--ink-3); }
  .cta { flex: none; font-size: 13px; font-weight: 500; color: var(--accent); }
  .cta::after { content: ' ›'; }
  .cta:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .localnav .wrap { height: auto; flex-wrap: wrap; padding-top: 8px; padding-bottom: 0; gap: 8px 16px; }
    .cta { margin-left: auto; }
    ul { width: 100%; margin: 0; gap: 18px; }
    li a { padding: 10px 0; }
  }
</style>
