---
// Spotlight testimonial slider. Pattern from humaninterest.com's home page (Bob, 2026-09-20): one card at a
// time, the client's photo filling the left half edge to edge, the quote on the right with a quote mark,
// the person, one meta line, and "Read the Story". Arrows sit outside the card at desktop width and move
// under it, beside the dots, on smaller screens (Human Interest's phone layout: photo on top, text under).
// Quotes must be verbatim and attributed, and checked against the banned list in the vault
// (50-resources/impact/testimonials-library.md) before they go in. Photos and links come from the story data.
import { href } from '../lib/site';
import type { SiteId } from '../lib/site';

interface Item {
  q: string;
  who: string;
  title?: string;
  co?: string;
  /** Short facts joined with " · ", e.g. industry, size, location. Only what the story records. */
  meta?: string[];
  image?: string;
  alt?: string;
  /** The story page; omit when there is none and the slide has no link. */
  path?: string;
  site?: SiteId;
}
interface Props {
  items: Item[];
  /** The link under the dots, e.g. See All Success Stories. */
  all?: { label: string; path: string; site?: SiteId };
  /** Fine print under everything, e.g. "Clients of IMPACT." */
  note?: string;
  class?: string;
}
const { items, all, note, class: cls } = Astro.props;
---

<div class:list={['spotlight', cls]} data-spotlight>
  <div class="stage">
    <ul>
      {items.map((t, i) => (
        <li data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="photo">
            {t.image ? <img src={t.image} alt={t.alt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} /> : <div class="frame" role="img" aria-label="Photo placeholder"></div>}
          </div>
          <div class="body">
            <span class="mark" aria-hidden="true">“</span>
            <blockquote class="say"><p>{t.q}</p></blockquote>
            <div class="who">
              <b>{t.who}</b>
              {(t.title || t.co) && <span>{[t.title, t.co].filter(Boolean).join(' at ')}</span>}
              {t.meta?.length ? <span class="meta">{t.meta.join(' · ')}</span> : null}
            </div>
            {t.path && <a class="more" href={href(t.site ?? 'impact', t.path)}>Read the Story →</a>}
          </div>
        </li>
      ))}
    </ul>
    <div class="ctrl">
      <button class="arrow prev" type="button" aria-label="Previous testimonial"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg></button>
      <div class="dots" role="tablist">
        {items.map((_, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Testimonial ${i + 1}`}></button>)}
      </div>
      <button class="arrow next" type="button" aria-label="Next testimonial"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></button>
    </div>
  </div>
  {all && <p class="all"><a href={href(all.site ?? 'impact', all.path)}>{all.label} →</a></p>}
  {note && <p class="note">{note}</p>}
</div>

<script>
  for (const s of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
    const slides = [...s.querySelectorAll<HTMLElement>('.stage > ul > li')];
    const dots = [...s.querySelectorAll<HTMLButtonElement>('.dots button')];
    let i = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((el, k) => { el.toggleAttribute('data-active', k === i); el.setAttribute('aria-hidden', String(k !== i)); });
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
    };
    s.querySelector('.prev')?.addEventListener('click', () => go(i - 1));
    s.querySelector('.next')?.addEventListener('click', () => go(i + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
  }
</script>
