---
// Renders a page from its outline: breadcrumbs, H1, lede, the section blocks, and a "how this page
// connects" strip. Enough to read the strategy off the page; not the finished page.
import Site from '../layouts/Site.astro';
import type { SiteId } from '../lib/site';
import { href } from '../lib/site';
import { pages, crumbParent, type PageEntry } from '../data/pages';
import type { Outline } from '../data/outlines';

interface Props { site: SiteId; page: PageEntry; outline: Outline }
const { site, page, outline } = Astro.props;

// Breadcrumb: group parent (linked to its hub) › section page if this is a sub-page › this page.
const hubFor: Record<string, string> = { 'How We Help': '/services', Results: '/results/success-stories', About: '/about', 'Learning Center': '/learn', Coaching: '/coaching' };
const crumbs: { label: string; path?: string }[] = [];
const parent = crumbParent[page.group];
if (parent) crumbs.push({ label: parent, path: hubFor[parent] });
const segs = page.path.replace(/^\//, '').split('/');
if (segs.length > 1) {
  const section = pages[site].find((p) => p.path === '/' + segs[0]);
  if (section) crumbs.push({ label: section.title, path: section.path });
}
const split = (s: string) => { const i = s.indexOf(' — '); return i < 0 ? [s, ''] : [s.slice(0, i), s.slice(i + 3)]; };
---

<Site site={site} title={page.title} path={page.path} status="draft">
  <section class="hero">
    <div class="wrap">
      {crumbs.length > 0 && (
        <p class="crumbs">
          {crumbs.map((c) => <>{c.path ? <a href={href(site, c.path)}>{c.label}</a> : <span class="t">{c.label}</span>}<span>&gt;</span></>)}
          <span class="here">{page.title}</span>
        </p>
      )}
      <h1>{outline.h1 ?? page.h1 ?? page.title}</h1>
      <p class="lede">{outline.lede ?? page.purpose}</p>
      {outline.ctas && (
        <div class="actions">
          {outline.ctas.map((c, i) => <a class:list={['btn', { primary: i === 0 }]} href={href(c.site ?? site, c.path)}>{c.label}{c.site && c.site !== site ? ' ↗' : ''}</a>)}
        </div>
      )}
    </div>
  </section>

  {outline.blocks.map((b, i) => (
    <section class:list={['section', 'block', { alt: i % 2 === 1 }]} id={i === 0 ? 'services' : undefined}>
      <div class="wrap">
        <div class="bhead">
          <h2>{b.h}</h2>
          {b.tag && <span class="tag plan">{b.tag}</span>}
        </div>
        {b.p && <p class="intro">{b.p}</p>}
        {b.kind === 'cards' && b.items && (
          <div class="grid c3 cards">{b.items.map((it) => { const [a, d] = split(it); return <div class="card"><h3>{a}</h3>{d && <p>{d}</p>}</div>; })}</div>
        )}
        {b.kind === 'steps' && b.items && (
          <ol class="steps">{b.items.map((it, n) => { const [a, d] = split(it); return <li><span class="n">{n + 1}</span><div><b>{a}</b>{d && <p>{d}</p>}</div></li>; })}</ol>
        )}
        {b.kind === 'pricing' && b.items && (
          <ul class="prices">{b.items.map((it) => { const [a, d] = split(it); return <li><span>{a}</span><b>{d}</b></li>; })}</ul>
        )}
        {b.kind === 'faq' && b.items && (
          <div class="faqs">{b.items.map((it) => { const [q, a] = split(it); return <details class="faq"><summary><h3>{q}</h3></summary><p>{a}</p></details>; })}</div>
        )}
        {b.kind === 'proof' && b.items && (
          <div class="grid c2">{b.items.map((it) => { const [q, w] = split(it); return <blockquote class="quote"><p>“{q}”</p>{w && <footer>{w}</footer>}</blockquote>; })}</div>
        )}
        {(!b.kind || b.kind === 'text' || b.kind === 'links') && b.items && (
          <ul class="plain">{b.items.map((it) => <li>{it}</li>)}</ul>
        )}
        {b.links && (
          <ul class="list-links small">{b.links.map((l) => <li><a href={href(l.site ?? site, l.path)}>{l.label}{l.site && l.site !== site ? ' ↗' : ''} <span class="arrow">→</span></a></li>)}</ul>
        )}
      </div>
    </section>
  ))}

  {(outline.connects || outline.source) && (
    <section class="section connects">
      <div class="wrap">
        <h2>How This Page Connects</h2>
        {outline.source && <p class="src">{outline.source}</p>}
        {outline.connects && (
          <ul>
            {outline.connects.map((c) => <li><span>{c.text}</span><a href={href(c.link.site ?? site, c.link.path)}>{c.link.label}{c.link.site && c.link.site !== site ? ' ↗' : ''} →</a></li>)}
          </ul>
        )}
      </div>
    </section>
  )}
</Site>
