---
// A page on one of the two sites: header, page body, footer, and the prototype strip.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Ribbon from '../components/Ribbon.astro';
import SectionBar from '../components/SectionBar.astro';
import { micrositeFor } from '../data/microsites';
import type { SiteId } from '../lib/site';
import { SITES, entryHref, realUrl } from '../lib/site';
import * as impact from '../data/impact-nav';
import * as ec from '../data/ec-nav';

interface Props {
  site: SiteId;
  title: string;
  description?: string;
  /** Real-site path of this page, e.g. "/pricing". Used for the strip and nav highlighting. */
  path: string;
  /** "draft" pages are proposed copy; "placeholder" pages exist only so the link works. */
  status?: 'draft' | 'placeholder';
}
const { site, title, description, path, status = 'draft' } = Astro.props;
const s = SITES[site];
const nav = site === 'ec' ? ec.nav : impact.nav;
const cta = site === 'ec' ? ec.cta : impact.cta;
const secondary = site === 'ec' ? ec.secondary : impact.secondary;
// Service microsites (coaching, HubSpot, websites, paid media): the header scrolls away and a section pill takes over.
const ms = micrositeFor(site, path);
// body[data-page] hook for the page-specific section of global.css: "impact-home", "impact-hubspot", "ec-coaching" …
const page = site + (path === '/' ? '-home' : path.replace(/\/+$/, '').replace(/\//g, '-'));
// Page theme (Bob, 2026-09-19): black for Endless Customers and coaching; plum + orange for HubSpot; magenta for websites;
// Swell's deep blue + teal for paid media; blue for everything else on impactplus.com. body[data-accent] drives the tint tokens.
const clean = '/' + path.replace(/^\/+|\/+$/g, '');
const accent = site === 'ec' || clean.startsWith('/coaching') ? 'black'
  : clean.startsWith('/hubspot') ? 'hubspot'
  : clean.startsWith('/websites') || clean === '/results/website-portfolio' ? 'magenta'
  : clean.startsWith('/paid-media') ? 'swell'
  : 'blue';
const mobileNote = site === 'ec'
  ? { text: 'Endless Customers is a brand of IMPACT.' }
  : { text: 'Not sure where to start?', link: impact.instantDiagnostic };
---

<Base title={`${title} · ${s.domain}`} description={description} favicon={site} microsite={!!ms} page={page} accent={accent} defaultDark={accent === 'black'}>
  <slot name="head" slot="head" />
  <Header site={site} nav={nav} cta={cta} secondary={secondary} mobileNote={mobileNote} currentPath={path} />
  <Ribbon site={site} path={path} ribbons={site === 'ec' ? ec.ribbons : impact.ribbons} />
  {ms && <SectionBar ms={ms} />}
  <main>
    <slot />
  </main>
  <Footer site={site} />

  <div class="proto" aria-label="Prototype">
    <span class="dot" aria-hidden="true"></span>
    <b>{realUrl(site, path)}</b>
    <span class="status">{status === 'placeholder' ? 'placeholder' : 'draft'}</span>
    <a href={entryHref()}>All pages</a>
  </div>
</Base>
