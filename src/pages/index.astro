---
// The entry page: pick a property, and see what has been drafted on each.
import Base from '../layouts/Base.astro';
import ImpactLogo from '../components/ImpactLogo.astro';
import ECLogo from '../components/ECLogo.astro';
import { SITES, href, type SiteId } from '../lib/site';
import { pages, draftedPaths } from '../data/pages';

const built = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });

function index(site: SiteId) {
  const drafted = draftedPaths(site);
  const groups = new Map<string, { path: string; title: string; drafted: boolean }[]>();
  for (const p of pages[site]) {
    if (!groups.has(p.group)) groups.set(p.group, []);
    groups.get(p.group)!.push({ path: p.path, title: p.title, drafted: drafted.has(p.path) });
  }
  const total = pages[site].length;
  const done = pages[site].filter((p) => drafted.has(p.path)).length;
  return { groups, total, done };
}
const impact = index('impact');
const ec = index('ec');
---

<Base title="IMPACT 2027 website prototype" description="Working prototype of impactplus.com and endlesscustomers.com. Not indexed.">
  <div class="entry">
    <div class="wrap">
      <header class="top">
        <p class="eyebrow">Prototype · updated {built} · not indexed</p>
        <h1 class="display">Two sites, one company.</h1>
        <p class="lede">impactplus.com is the full-service company. endlesscustomers.com is the system. Pick one to walk through it; the strip in the corner of every page shows where you are and brings you back here.</p>
      </header>

      <div class="pick">
        <a class="site impact" href={href('impact', '/')}>
          <span class="logo"><ImpactLogo /></span>
          <span class="domain">impactplus.com</span>
          <span class="what">The full-service company. Diagnostic first, then coaching, HubSpot, websites, paid media, workshops.</span>
          <span class="count">{impact.done} of {impact.total} pages drafted</span>
        </a>
        <a class="site ec" href={href('ec', '/')}>
          <span class="logo ec"><ECLogo /></span>
          <span class="domain">endlesscustomers.com</span>
          <span class="what">The system. The book, the conference, the coaches, the learning center, and what it costs to implement.</span>
          <span class="count">{ec.done} of {ec.total} pages drafted</span>
        </a>
      </div>

      <div class="indexes">
        {([['impact', impact], ['ec', ec]] as const).map(([site, ix]) => (
          <section class="index">
            <h2>{SITES[site].domain}</h2>
            {[...ix.groups].map(([group, list]) => (
              <div class="group">
                <h3>{group}</h3>
                <ul>
                  {list.map((p) => (
                    <li>
                      <a href={href(site, p.path)}>{p.title}</a>
                      <span class:list={['tag', p.drafted ? 'ok' : 'plan']}>{p.drafted ? 'drafted' : 'placeholder'}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))}
      </div>

      <footer class="foot">
        <p>Drafted means the page has proposed copy and layout to react to. Placeholder means the link works and the page says what it is for. Nothing here is final, and none of it is indexed by search engines.</p>
      </footer>
    </div>
  </div>
</Base>

<style>
  .entry { padding: 72px 0 96px; min-height: 100vh; }
  .top { max-width: 760px; margin-bottom: 48px; }
  .top .display { max-width: 16ch; }
  .pick { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 72px; }
  .site {
    display: grid; gap: 14px; align-content: start; padding: 32px; min-height: 260px;
    background: var(--bg-panel); border: 1px solid var(--line); border-radius: 20px;
    transition: transform .2s var(--ease), border-color .15s var(--ease), box-shadow .2s var(--ease);
  }
  .site:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: var(--shadow); }
  .site .logo :global(svg) { height: 34px; width: auto; }
  .site .logo:not(.ec) :global(svg path) { fill: var(--ink); }
  .site .logo.ec :global(svg) { height: 48px; }
  .site .logo.ec :global(svg path:not([fill])) { fill: var(--ink); }
  .site .domain { font-size: 22px; font-weight: 600; letter-spacing: -.02em; margin-top: 8px; }
  .site .what { color: var(--ink-2); font-size: 15px; max-width: 40ch; text-wrap: pretty; }
  .site .count { margin-top: auto; padding-top: 12px; font-size: 13px; color: var(--ink-3); }
  .site.ec:hover .domain { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .indexes { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .index h2 { font-size: 15px; font-weight: 600; margin: 0 0 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line-strong); }
  .group { margin-bottom: 24px; }
  .group h3 { margin: 0 0 6px; font-size: 12px; font-weight: 400; color: var(--ink-3); letter-spacing: .01em; }
  .group ul { list-style: none; margin: 0; padding: 0; }
  .group li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 15px; font-weight: 500; }
  .group li a:hover { color: var(--accent); }
  .foot { margin-top: 48px; color: var(--ink-3); font-size: 14px; max-width: 64ch; }
  .foot p { margin: 0; }
  @media (max-width: 800px) {
    .entry { padding: 40px 0 64px; }
    .pick, .indexes { grid-template-columns: 1fr; }
    .site { min-height: 0; padding: 24px; }
  }
</style>
