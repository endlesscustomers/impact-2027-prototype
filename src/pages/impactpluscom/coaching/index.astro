---
// Endless Customers Coaching microsite home on impactplus.com. This is the source page for coaching;
// endlesscustomers.com/coaching is the door that hands off here. Coach profiles live on
// endlesscustomers.com/coaches, and this page links there rather than duplicating them.
import Site from '../../../layouts/Site.astro';
import { href, asset } from '../../../lib/site';

const path = '/coaching';
const plans = [
  ['Guidance', '$5,500/mo', 'Bi-weekly coaching, one track. For teams with a content manager already in place.'],
  ['Mastery', '$8,000/mo', 'Weekly coaching across sales and marketing. Where most companies belong.', true],
  ['Mastery Accelerated', '$10,500/mo', 'Everything in Mastery, compressed. For leadership teams in a hurry.'],
];
const coaches = [
  ['Allison Belles', 'Executive Coach', 'allison-belles.jpg'],
  ['Vin Gaeta', 'Executive Coach', 'vin-gaeta.jpg'],
  ['Mandy York', 'Coach', 'mandy-york.jpg'],
];
---

<Site site="impact" title="Endless Customers Coaching" path={path} description="Endless Customers coaching from IMPACT, the company behind the system: a coach who works like a fractional chief revenue officer until your team runs the system without them.">
  <section class="hero ms-hero">
    <div class="wrap">
      <p class="crumbs"><a href={href('impact', '/services')}>How We Help</a><span>&gt;</span><span class="here">Endless Customers Coaching</span></p>
      <div class="hero-grid">
        <div>
          <img class="wordmark" src={asset('img/ec-logo-black.svg')} alt="Endless Customers" width="200" />
          <h1>Become the Most Trusted Voice in Your Market, With a Coach in Your Corner</h1>
          <p class="lede">A certified Endless Customers coach works with your leadership, sales, and marketing teams, like a fractional chief revenue officer, until the system runs without them. Delivered by IMPACT, the company behind the system.</p>
          <div class="actions">
            <a class="btn primary" href={href('impact', '/talk')}>Book an Explore Call</a>
            <a class="btn" href={href('impact', '/coaching/pricing')}>See Pricing</a>
          </div>
        </div>
        <aside class="path">
          <p class="cap">The sequence</p>
          <ol>
            <li><b>Free Instant Diagnostic</b><span>How AI sees you today</span></li>
            <li><b>Deep Diagnostic &amp; Roadmap</b><span>$5,000 · the plan</span></li>
            <li class="live"><b>Coaching</b><span>Alignment Day, then weekly</span></li>
            <li><b>Mastery</b><span>Your team runs it</span></li>
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What a Coach Actually Does</h2>
      <div class="grid c4">
        <div class="card"><h3>Sits With Leadership</h3><p>In your leadership meetings and quarterly planning, pushing on the hard things.</p></div>
        <div class="card"><h3>Trains the Team</h3><p>Content and video, website, assignment selling, HubSpot, practical AI. Weekly or bi-weekly, in your business.</p></div>
        <div class="card"><h3>Holds the Plan</h3><p>A 90-day plan, tracked every quarter. Accountability is most of the value.</p></div>
        <div class="card"><h3>Builds the Team</h3><p>Helps you hire a content manager and a videographer, and makes sales use what they make.</p></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>How It Works</h2>
      <ol class="steps">
        <li><span class="n">1</span><div><b>Alignment Day</b><p>Leadership, sales, and marketing in one room. Everyone understands the system and their role. $10,000 virtual, $12,500 + travel in person.</p></div></li>
        <li><span class="n">2</span><div><b>First 90-Day Plan</b><p>Benchmark where you are, set priorities.</p></div></li>
        <li><span class="n">3</span><div><b>Coaching and Training</b><p>Weekly or bi-weekly, by plan. Quarterly planning resets priorities.</p></div></li>
        <li><span class="n">4</span><div><b>Mastery</b><p>Your team runs it. Coaching gets lighter or ends. Many clients keep a quarterly session.</p></div></li>
      </ol>
      <a class="more" href={href('impact', '/coaching/how-it-works')}>How It Works, in Detail →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Plans</h2>
      <p class="intro">Month to month, 30-day notice, after the Deep Diagnostic and an Alignment Day. <span class="tag plan">Live-site pricing, to verify for 2027</span></p>
      <div class="grid c3">
        {plans.map(([name, price, what, rec]) => (
          <div class:list={['card', 'plan', { rec }]}>
            {rec && <span class="badge">Recommended</span>}
            <h3>{name}</h3>
            <span class="price">{price}</span>
            <p>{what}</p>
          </div>
        ))}
      </div>
      <p class="also">Every call, training, and deliverable is covered by the <a href={href('impact', '/guarantee')}>100% money-back guarantee</a>. What the full implementation costs, beyond coaching, is on <a href={href('ec', '/pricing')}>endlesscustomers.com/pricing ↗</a>.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>Your Coaches</h2>
          <p class="intro">IMPACT’s coaches, and the certified independent coaches who deliver the same system. Every coach is listed in one directory on endlesscustomers.com; this page shows a few.</p>
          <a class="btn" href={href('ec', '/coaches')}>Every Certified Coach, on endlesscustomers.com ↗</a>
        </div>
        <div class="faces">
          {coaches.map(([name, role, img]) => (
            <a class="face" href={href('ec', '/coaches')}>
              <img src={asset(`img/people/${img}`)} alt={name} width="96" height="96" loading="lazy" />
              <b>{name}</b><span>{role}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Results</h2>
      <div class="grid c3">
        <blockquote class="quote"><p>“In three years, we saw 4x more sales qualified leads in our pipeline and 7x revenue growth.”</p><footer>Patrick Moorhead, former CMO, Pricefx</footer></blockquote>
        <blockquote class="quote"><p>“Sales opportunities tripled, especially from qualified leads. We even hired our first salesperson in four years.”</p><footer>Mike Ritzema, Founder and President, Superior Trucking Payroll</footer></blockquote>
        <blockquote class="quote"><p>“IMPACT doesn’t do the work for you. They teach you how to own it.”</p><footer>Davy Clay, Co-Founder, Dental Claim Support</footer></blockquote>
      </div>
      <a class="more" href={href('impact', '/coaching/results')}>More Coaching Results →</a>
    </div>
  </section>

  <section class="section connects">
    <div class="wrap">
      <h2>How This Section Connects</h2>
      <p class="src">impactplus.com is the source for coaching. endlesscustomers.com describes the system and hands off here.</p>
      <ul>
        <li><span>The door on the Endless Customers side: what coaching is, book a call there, or come here for the detail</span><a href={href('ec', '/coaching')}>endlesscustomers.com/coaching ↗ →</a></li>
        <li><span>Every certified coach, IMPACT and independent, in one directory</span><a href={href('ec', '/coaches')}>endlesscustomers.com/coaches ↗ →</a></li>
        <li><span>The other ways to implement the system, without a coach</span><a href={href('ec', '/how-to-implement')}>How to implement ↗ →</a></li>
        <li><span>Where coaching starts</span><a href={href('impact', '/deep-diagnostic')}>Deep Diagnostic &amp; Roadmap →</a></li>
      </ul>
    </div>
  </section>
</Site>

<style>
.path { padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--bg-panel); }
  .path .cap { margin: 0 0 12px; font-size: 12px; color: var(--ink-3); }
  .path ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; counter-reset: s; }
  .path li { display: grid; grid-template-columns: 24px 1fr; gap: 10px; align-items: baseline; padding: 8px 0; border-top: 1px solid var(--line); counter-increment: s; }
  .path li::before { content: counter(s); font-size: 12px; color: var(--ink-3); }
  .path li b { display: block; font-weight: 600; font-size: 15px; }
  .path li span { display: block; grid-column: 2; font-size: 13px; color: var(--ink-3); }
  .path li.live b { color: var(--accent); }
  .split { grid-template-columns: 1.1fr 1fr; align-items: center; }
</style>
