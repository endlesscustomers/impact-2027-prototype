---
import StoryPage from '../../../../components/StoryPage.astro';
import { storiesFor } from '../../../../data/stories';
export function getStaticPaths() {
  return storiesFor('impact').map((story) => ({ params: { slug: story.slug }, props: { story } }));
}
const { story } = Astro.props;
---
<StoryPage site="impact" story={story} />
