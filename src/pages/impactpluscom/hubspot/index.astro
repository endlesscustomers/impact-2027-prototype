---
// HubSpot Services microsite home. A HubSpot buyer who lands here should see a complete HubSpot
// partner: what we do, who does it, what it costs, proof, and one CTA. Same IMPACT header; the
// local nav under it is the microsite. No sub-brand (HubSpot's partner rules bar "Hub" or "HubSpot"
// in a partner's program name). Facts and prices from the live site, 2026-09-18.
import Site from '../../../layouts/Site.astro';
import { href, asset } from '../../../lib/site';

const path = '/hubspot';

const problems = [
  ['We bought HubSpot and nobody uses it.', 'Training in your own portal until the team owns it.', '/hubspot/training'],
  ['Our HubSpot is a mess and nobody trusts the numbers.', 'A portal audit, then the cleanup, then reports leadership believes.', '/hubspot/cleanup'],
  ['We’re starting from scratch and don’t want to get it wrong.', 'Onboarding configured for how your team actually sells.', '/hubspot/onboarding'],
  ['HubSpot doesn’t talk to our ERP / accounting / e-commerce.', 'Integrations and migrations, with engineers where the work needs them.', '/hubspot/integrations'],
  ['We need a website our team can change without a developer.', 'The Trust theme: IMPACT’s HubSpot CMS theme.', '/hubspot/trust-theme'],
  ['We want to actually use Breeze AI.', 'Agents and assistants configured to your data, and a team trained to run them.', '/hubspot/onboarding'],
];
const programs = [
  ['Core', '$3,500/mo', 'Two sessions a month, one specialist, one department up to 10 people.'],
  ['Advanced', '$6,000/mo', 'Weekly sessions, multiple departments, deeper curriculum.'],
  ['Organization', '$10,000/mo', 'Multiple weekly tracks, role-based, with leadership coordination.'],
];
const team = [
  ['Jessica Palmeri', 'Director of HubSpot Training', 'jessica-palmeri.jpg'],
  ['Joe Bachir', 'HubSpot Trainer', 'joe-bachir.jpg'],
  ['Kaitlyn Petro', 'HubSpot Trainer', 'kaitlyn-petro.jpg'],
];
const quotes = [
  ['IMPACT’s overall customized approach and strategy to training is far superior to anything else.', 'Chris Garnett, Chief Marketing & Sales Officer, PartnerMD'],
  ['From knowing almost nothing in regards to online marketing, to now taking on my own projects within HubSpot, in just months.', 'Janine Estolas, Western States Metal Roofing'],
  ['Their coaching made a big difference in helping our sales team get comfortable with our new CRM and actually use it effectively.', 'Cheryl Parker, Kaplan Learning'],
];
const faqs = [
  ['Are you a HubSpot agency?', 'We’re a HubSpot Diamond Solutions Partner, and HubSpot services are one of IMPACT’s six services. The difference from a typical HubSpot agency: we train your team to run the portal, so you don’t need us forever.'],
  ['Do we have to do the Deep Diagnostic first?', 'No. HubSpot work can start on its own. If you don’t know whether HubSpot is the problem, the Deep Diagnostic will tell you where it sits in the order of things to fix.'],
  ['Do you do migrations from Salesforce?', 'Yes, with our integration partner’s engineers on the technical side and our trainers on the people side.'],
  ['Is the work guaranteed?', 'Every project and every training session is covered by the 100% money-back guarantee. Tell us within 7 days, we redo it, and if we still miss, you get your money back.'],
];
---

<Site site="impact" title="HubSpot Services" path={path} description="HubSpot training, onboarding, cleanup, integrations, and the Trust theme, from a HubSpot Diamond Solutions Partner that trains your team to run it.">
  <section class="hero ms-hero">
    <div class="wrap">
      <p class="crumbs"><a href={href('impact', '/services')}>How We Help</a><span>&gt;</span><span class="here">HubSpot Services</span></p>
      <div class="hero-grid">
        <div>
          <h1>The HubSpot Team That Gets You Out of the Mess and Into the Results</h1>
          <p class="lede">Training, onboarding, cleanup, integrations, and a CMS theme your marketing manager can run, from a HubSpot Diamond Solutions Partner. We leave your team able to run it, which is the part most partners skip.</p>
          <div class="actions">
            <a class="btn primary" href={href('impact', '/talk')}>Talk to a HubSpot Expert</a>
            <a class="btn" href={href('impact', '/hubspot/pricing')}>See Pricing</a>
          </div>
        </div>
        <aside class="creds">
          <img src={asset('img/badges/hubspot-diamond.webp')} alt="HubSpot Diamond Solutions Partner" />
          <ul>
            <li><b>5.0</b> on the HubSpot directory, 327+ reviews</li>
            <li><b>15+</b> years as a HubSpot partner</li>
            <li><b>2x</b> HubSpot Partner of the Year</li>
            <li><b>27</b> certifications across the team</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <h2>What We Hear Most Often</h2>
      <p class="intro">Pick the one that sounds like you. Each leads to the service, the process, and the price.</p>
      <div class="grid c3">
        {problems.map(([say, how, p]) => (
          <a class="card" href={href('impact', p)}><h3>“{say}”</h3><p>{how}</p><span class="more">How We Handle It →</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>What Makes IMPACT Different From Other HubSpot Partners</h2>
          <p class="intro">Most partners set HubSpot up and leave. Some manage it for you forever. We do the setup, and then we train your team in your own portal until they don’t need us. That’s the same thing we do with content, sales, and websites, because it’s the whole point of IMPACT.</p>
          <p class="intro">HubSpot is only as powerful as the team using it.</p>
        </div>
        <ol class="steps">
          <li><span class="n">1</span><div><b>Discovery &amp; Kickoff</b><p>A worksheet, then a deep dive with your specialist.</p></div></li>
          <li><span class="n">2</span><div><b>Training Roadmap</b><p>Priorities and a curriculum for your team.</p></div></li>
          <li><span class="n">3</span><div><b>Sessions in Your Portal</b><p>Screen-share, in your actual HubSpot. Your team applies it between sessions.</p></div></li>
          <li><span class="n">4</span><div><b>Independence</b><p>The program ends when your team owns the portal.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Training Programs</h2>
      <p class="intro">Priced by how many people and departments need training. Three-month minimum, then month to month. <span class="tag plan">Live-site pricing, to verify for 2027</span></p>
      <div class="grid c3">
        {programs.map(([name, price, what]) => (
          <div class="card plan">
            <h3>{name}</h3>
            <span class="price">{price}</span>
            <p>{what}</p>
            <a class="more" href={href('impact', '/hubspot/training')}>Details →</a>
          </div>
        ))}
      </div>
      <p class="also">Also: an on-site workshop, $12,500 + travel, a full day at your office plus 4–6 weeks of virtual follow-up. Projects (onboarding, cleanup, dashboards, Breeze AI) run $3,000 to $15,000+ and are quoted after a scoping call. <a href={href('impact', '/hubspot/pricing')}>All HubSpot pricing →</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>Meet Your HubSpot Certified Trainers</h2>
      <p class="intro">The same people every session. Certified, and in your portal, not a slide deck.</p>
      <div class="grid c3 team">
        {team.map(([name, role]) => (
          <div class="person">
            <span class="ph" aria-hidden="true">{name.split(' ').map((w) => w[0]).join('')}</span>
            <b>{name}</b>
            <span>{role}</span>
          </div>
        ))}
      </div>
      <a class="more" href={href('impact', '/hubspot/experts')}>The HubSpot Team, and Our Integration Partner →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What Clients Say</h2>
      <div class="grid c3">
        {quotes.map(([q, who]) => <blockquote class="quote"><p>“{q}”</p><footer>{who}</footer></blockquote>)}
      </div>
      <p class="also">More on the <a href="https://ecosystem.hubspot.com/marketplace/solutions/impact" target="_blank" rel="noopener">HubSpot directory ↗</a> and on our <a href={href('impact', '/hubspot/results')}>results page</a>.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>Questions HubSpot Buyers Ask</h2>
      <div class="faqs">
        {faqs.map(([q, a]) => <details class="faq"><summary><h3>{q}</h3></summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section connects">
    <div class="wrap">
      <h2>How This Section Connects</h2>
      <ul>
        <li><span>One of six IMPACT services; the roadmap from the Deep Diagnostic says whether it’s first</span><a href={href('impact', '/services')}>All services →</a></li>
        <li><span>Coaching clients bring in the HubSpot team for add-on projects</span><a href={href('impact', '/coaching')}>Endless Customers Coaching →</a></li>
        <li><span>The Trust theme is shared with Website Services</span><a href={href('impact', '/websites')}>Website Services →</a></li>
        <li><span>HubSpot problems in the buyer’s words</span><a href={href('impact', '/help/crm')}>CRM and Customer Data →</a></li>
      </ul>
    </div>
  </section>
</Site>
