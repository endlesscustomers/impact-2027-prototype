<script>
  // Library-only theme switcher: sets body[data-accent] (the page theme) and flips dark mode through the
  // header's own toggle so the two stay in sync. The choice lives in sessionStorage for this tab only.
  const sw = document.querySelector<HTMLElement>('.mod-switch');
  if (sw) {
    const html = document.documentElement, body = document.body;
    const themeBtns = [...sw.querySelectorAll<HTMLButtonElement>('[data-theme]')];
    const modeBtn = sw.querySelector<HTMLButtonElement>('[data-mode]')!;
    const paint = () => {
      themeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === body.dataset.accent)));
      modeBtn.setAttribute('aria-pressed', String(html.hasAttribute('data-dark')));
    };
    const saved = sessionStorage.getItem('modules-theme');
    if (saved) body.dataset.accent = saved;
    themeBtns.forEach((b) => b.addEventListener('click', () => { body.dataset.accent = b.dataset.theme!; sessionStorage.setItem('modules-theme', b.dataset.theme!); paint(); }));
    modeBtn.addEventListener('click', () => { (document.querySelector('.theme') as HTMLElement | null)?.click(); setTimeout(paint, 50); });
    new MutationObserver(paint).observe(html, { attributes: true, attributeFilter: ['data-dark'] });
    paint();
  }
</script>
